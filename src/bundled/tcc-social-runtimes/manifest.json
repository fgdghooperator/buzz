{
  "id": "tcc.social-runtimes",
  "name": "TCC Social Runtimes",
  "apiVersion": 1,
  "description": "Run the proven TCC runtimes and dedicated FGD Hermes agent profiles in Buzz.",
  "discovery": {
    "category": "agents",
    "tags": ["TCC", "FGD", "social", "agents"]
  },
  "host": {
    "processes": [
      {
        "id": "tcc-timmy-acp",
        "program": "hermes",
        "args": ["-p", "timmy", "acp"]
      },
      {
        "id": "tcc-grok-acp",
        "program": "grok",
        "args": ["agent", "--always-approve", "stdio"]
      },
      {
        "id": "fgd-jimmy-acp",
        "program": "hermes",
        "args": ["-p", "jimmy", "acp"]
      },
      {
        "id": "fgd-kenny-acp",
        "program": "hermes",
        "args": ["-p", "kenny", "acp"]
      },
      {
        "id": "fgd-wendy-acp",
        "program": "hermes",
        "args": ["-p", "wendy", "acp"]
      },
      {
        "id": "fgd-tweak-acp",
        "program": "hermes",
        "args": ["-p", "tweak", "acp"]
      },
      {
        "id": "fgd-pip-acp",
        "program": "hermes",
        "args": ["-p", "pip", "acp"]
      },
      {
        "id": "fgd-craig-acp",
        "program": "hermes",
        "args": ["-p", "craig", "acp"]
      }
    ],
    "mcp": true,
    "files": true
  }
}
